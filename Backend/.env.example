# Local development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local PostgreSQL (used when DATABASE_URL is empty)
DB_NAME=helpdesk_db
DB_USER=helpdesk_user
DB_PASSWORD=replace-with-a-secure-password
DB_HOST=localhost
DB_PORT=5432

# Production PostgreSQL connection string (for example, Neon)
DATABASE_URL=

# Frontend/backend connection
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional production upload storage
CLOUDINARY_URL=
CLOUDINARY_MEDIA_PREFIX=spus-helpdesk-private-media

# Initial deployment account (used only to create/promote the first admin)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_USERNAME=

# Production security overrides (the secure defaults apply when DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_HSTS_PRELOAD=True

# Email remains in the console until a real email provider is configured
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@spus-helpdesk.local
